<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RealX - Player</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Navbar (Upar ki patti - Home page jaisi) -->
    <header class="navbar">
        <div class="left-nav">
            <button id="menu-btn" class="icon-btn" style="background: none; border: none; color: white; font-size: 20px; cursor: pointer;">☰</button>
            <a href="index.html" class="logo" style="text-decoration: none; color: white; font-size: 24px; font-weight: bold; margin-left: 15px;">RealX</a>
        </div>
        <div class="search-bar">
            <!-- Search box yahan bhi kaam karega -->
            <input type="text" id="search-input" placeholder="Search videos...">
        </div>
    </header>

    <!-- Sidebar (Left Menu) -->
    <div id="sidebar" class="sidebar">
        <a href="index.html">🏠 Home</a>
        <a href="#">📁 Category</a>
    </div>

    <!-- Main Player Area -->
    <main class="player-container">
        
        <!-- Upar chalne wali Main Video -->
        <div class="video-section">
            <video id="main-player" controls autoplay style="width: 100%; border-radius: 12px; background: #000; max-height: 500px;">
                <source src="" type="video/mp4">
            </video>
            <h2 id="video-title" class="video-title-main">Loading...</h2>
            <p id="video-stats" class="video-stats-main">Loading details...</p>
        </div>

        <hr style="border: 0.5px solid #333; margin: 20px 0;">

        <!-- Niche aane wali YouTube style list (Up Next) -->
        <div class="recommendations-section">
            <h3>Up Next</h3>
            <div id="recommendations-list" class="r-list">
                <!-- Javascript se aaki bachi hui videos yahan khud aa jayengi -->
            </div>
        </div>

    </main>

    <script src="script.js"></script>
</body>
</html>
